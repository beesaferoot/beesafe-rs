print("2 + 3 * 4  =", 2 + 3 * 4)
print("2 * 3 / 4  =", 2 * 3 / 4)
print("10 - 5 + 2 =", 10 - 5 + 2)
print("(12 / 2) * 3 =", (12 / 2) * 3)
print("7 / 2      =", 7 / 2)
print("0 - 3      =", 0 - 3)

// ---
// 2 + 3 * 4  = 14
// 2 * 3 / 4  = 1
// 10 - 5 + 2 = 7
// (12 / 2) * 3 = 18
// 7 / 2      = 3
// 0 - 3      = -3
